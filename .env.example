# =====================================================================
# ProYuk backend — muhit o'zgaruvchilari (namuna)
#
# Bu fayl GitHub'ga yuboriladi: bu yerga HAQIQIY parol yoki kalitni
# YOZMANG. Haqiqiy qiymatlar:
#   - Render'da:  Web Service -> Environment -> "Add Environment Variable"
#   - Kompyuterda: shu papkadagi .env fayli (u GitHub'ga yuborilmaydi)
#
# Render'ga qo'shiladiganlar (qisqa ro'yxat):
#   PYTHON_VERSION        3.13.1
#   DEBUG                 False
#   SECRET_KEY            (Generate tugmasi)
#   STORE_BACKEND         firestore
#   FIREBASE_PROJECT_ID   proyuk-proff
#   FIREBASE_CREDENTIALS  (service account JSON faylining butun matni)
#   ADMIN_EMAIL           (administrator pochtasi)
#   ADMIN_PASSWORD        (administrator paroli)
#
# DATABASE_URL endi KERAK EMAS: bo'lsa, Render'dan o'chirib tashlang.
# =====================================================================

# --- Majburiy -------------------------------------------------------

# Python versiyasi (repodagi .python-version bilan bir xil)
PYTHON_VERSION=3.13.1

# Production rejimi
DEBUG=False

# Django maxfiy kaliti: JWT tokenlar shu bilan imzolanadi.
# Render'da "Generate" tugmasi bilan yarating. Keyin O'ZGARTIRMANG,
# aks holda hamma foydalanuvchilar tizimdan chiqib ketadi.
SECRET_KEY=your-secret-key-here

# Ma'lumotlar saqlanadigan joy: firestore (Render) | jsonfile (lokal kompyuter)
STORE_BACKEND=firestore

# Firebase loyiha ID (Firebase Console -> Project settings -> Project ID)
FIREBASE_PROJECT_ID=proyuk-proff

# Service account kaliti:
#   Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> JSON fayl yuklanadi.
# Shu faylni Bloknotda ochib, BUTUN matnini ({ dan } gacha) Render'dagi
# qiymat maydoniga qo'ying (yoki uning base64 ko'rinishini).
# Bu yerga va GitHub'ga HECH QACHON yozmang.
FIREBASE_CREDENTIALS=

# Administrator hisobi: birinchi deployda yaratiladi.
# Bunday pochtali hisob bo'lsa, paroliga tegilmaydi, faqat admin huquqi beriladi.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# --- Bajarilgan ishlar fayllari (Supabase Storage) ------------------
# Supabase -> Project Settings -> API: Project URL va service_role kaliti.
# Storage'da YOPIQ (private) "ish-dalillari" bucket yarating.
# service_role kaliti maxfiy — faqat Render'ga yozing, repoga emas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=ish-dalillari
# Lokal ishlashda fayllar .local_files/ papkasida saqlanadi (FILE_STORAGE=local).

# --- Ixtiyoriy -----------------------------------------------------

# Firestore baza nomi. Firebase'da bitta standart baza bo'lsa, qo'shmang.
# FIRESTORE_DATABASE=(default)

# Frontend manzili(lari), vergul bilan. Frontend (Firebase Hosting) brauzerdan
# to'g'ridan-to'g'ri backendga murojaat qiladi — majburiy.
# Masalan: https://proyuk-proff.web.app,https://proyuk-proff.firebaseapp.com
CORS_ALLOWED_ORIGINS=

# Qo'shimcha domenlar. Render manzili (....onrender.com) avtomatik qo'shiladi.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Faqat kompyuterda (.env) ----------------------------------------
# Lokal ishlash uchun .env faylga quyidagini yozsangiz yetarli
# (Firestore kerak emas, ma'lumotlar .localstore.json faylida):
#   DEBUG=True
#   STORE_BACKEND=jsonfile
