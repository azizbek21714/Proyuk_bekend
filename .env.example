# =====================================================================
# ProYuk backend — muhit o'zgaruvchilari (namuna)
#
# Bu fayl GitHub'ga yuboriladi: bu yerga HAQIQIY parol, kalit yoki
# baza manzilini YOZMANG. Haqiqiy qiymatlar:
#   - Render'da:  Web Service → Environment
#   - Kompyuterda: shu papkadagi .env fayli (u GitHub'ga yuborilmaydi)
# =====================================================================

# --- Majburiy (Render) ---------------------------------------------

# Production rejimi
DEBUG=False

# Django maxfiy kaliti. Render'da "Generate" tugmasi bilan yarating.
SECRET_KEY=your-secret-key-here

# Ma'lumotlar saqlanadigan joy: firestore (Render) | jsonfile (lokal kompyuter)
STORE_BACKEND=firestore

# Firebase loyiha ID (Firebase Console -> Project settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service account kaliti: Firebase Console -> Project settings -> Service accounts
# -> "Generate new private key". Yuklangan JSON faylning BUTUN matnini
# (yoki uning base64 ko'rinishini) Render'dagi qiymatga qo'ying. Bu yerga YOZMANG.
FIREBASE_CREDENTIALS=

# Ixtiyoriy: Firestore baza nomi (odatda "(default)")
# FIRESTORE_DATABASE=(default)

# Birinchi deployda yaratiladigan administrator hisobi
# (keyingi deploylarda mavjud hisob o'zgartirilmaydi)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# --- Ixtiyoriy -----------------------------------------------------

# Python versiyasi (repodagi .python-version bilan bir xil)
PYTHON_VERSION=3.13.1

# Frontend manzili(lari), vergul bilan. Frontend Django'ga server orqali
# ulanadi, shuning uchun odatda bo'sh qoldirish mumkin.
CORS_ALLOWED_ORIGINS=

# Qo'shimcha domenlar. Render manzili (....onrender.com) avtomatik qo'shiladi.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
